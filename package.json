{
  "name": "swing10",
  "version": "0.1.0",
  "private": true,
  "description": "Event-driven Indian equity swing scanner — paper trading only",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"tests/**/*.test.ts\"",
    "db:init": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/cli.ts db:init",
    "db:status": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/cli.ts db:status",
    "sources": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/cli.ts sources",
    "ingest:manual": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/cli.ts ingest:manual",
    "feed:smoke": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/cli.ts feed:smoke",
    "scan": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/cli.ts scan",
    "replay": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/cli.ts replay",
    "label": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/cli.ts label",
    "validate": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/cli.ts validate",
    "scan:once": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/cli.ts scan:once",
    "scanner:start": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/cli.ts scanner:start"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
